{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Chart of Accounts",
  "type": "object",

  "properties": {
    "accounts": {
      "type": "object",

      "properties": {
        "assets": {
          "type": "array",
          "items": { "type": "string" }
        },

        "expenses": {
          "type": "array",
          "items": { "type": "string" }
        },

        "revenue": {
          "type": "array",
          "items": { "type": "string" }
        },

        "equity": {
          "type": "array",
          "items": { "type": "string" }
        }
      },

      "required": ["assets", "expenses", "revenue", "equity"]
    }
  },

  "required": ["accounts"]
}
