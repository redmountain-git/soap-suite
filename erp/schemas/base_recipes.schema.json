{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["base_recipes"],

  "properties": {
    "base_recipes": {
      "type": "array",

      "items": {
        "type": "object",
        "required": ["name", "id", "oils", "base_lye"],

        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },

          "id": {
            "type": "string",
            "pattern": "^BSR-[0-9]{3}$"
          },

          "oils": {
            "type": "object",
            "minProperties": 2,

            "additionalProperties": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            }
          },

          "base_lye": {
            "type": "object",
            "required": ["type", "purity_percent", "superfat_percent"],

            "properties": {
              "type": {
                "enum": ["NaOH", "KOH"]
              },

              "purity_percent": {
                "type": "number",
                "minimum": 90,
                "maximum": 100
              },

              "superfat_percent": {
                "type": "number",
                "minimum": 0,
                "maximum": 15
              }
            }
          },

          "quality_targets": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
