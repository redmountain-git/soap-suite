{
  "name": "operations-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/operations-e2e/src",
  "implicitDependencies": ["operations"],
  "// targets": "to see all targets run: nx show project operations-e2e --web",
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p apps/operations-e2e/tsconfig.json --noEmit"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint apps/operations-e2e/src --max-warnings=0"
      }
    },
    "e2e": {
      "executor": "nx:run-commands",
      "dependsOn": [
        {
          "projects": "operations",
          "target": "build",
          "params": "ignore"
        }
      ],
      "options": {
        "command": "playwright test --config apps/operations-e2e/playwright.config.mts"
      }
    }
  }
}
