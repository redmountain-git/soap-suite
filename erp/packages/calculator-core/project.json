{
  "name": "calculator-core",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "packages/calculator-core/src",
  "tags": ["scope:public", "type:domain"],
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "tsc -p packages/calculator-core/tsconfig.lib.json --noEmit",
          "tsc -p packages/calculator-core/tsconfig.spec.json --noEmit"
        ],
        "parallel": false
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --config packages/calculator-core/vitest.config.ts"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/packages/calculator-core"],
      "options": {
        "command": "node tools/clean-package.mjs calculator-core && tsc -p packages/calculator-core/tsconfig.lib.json && node tools/prepare-package.mjs calculator-core"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint packages/calculator-core/src --max-warnings=0"
      }
    }
  }
}
