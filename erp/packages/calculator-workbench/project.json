{
  "name": "calculator-workbench",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "packages/calculator-workbench/src",
  "tags": ["scope:public", "type:ui", "framework:lit"],
  "implicitDependencies": ["calculator-core", "vector-widgets"],
  "targets": {
    "typecheck": {
      "dependsOn": [{ "projects": ["vector-widgets"], "target": "styles" }],
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "tsc -p packages/calculator-workbench/tsconfig.lib.json --noEmit",
          "tsc -p packages/calculator-workbench/tsconfig.spec.json --noEmit"
        ],
        "parallel": false
      }
    },
    "test": {
      "dependsOn": [{ "projects": ["vector-widgets"], "target": "styles" }],
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --config packages/calculator-workbench/vitest.config.ts"
      }
    },
    "build": {
      "dependsOn": ["^build"],
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/packages/calculator-workbench"],
      "options": {
        "command": "node tools/clean-package.mjs calculator-workbench && tsc -p packages/calculator-workbench/tsconfig.lib.json && node tools/prepare-package.mjs calculator-workbench"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint packages/calculator-workbench/src --max-warnings=0"
      }
    }
  }
}
