{
  "name": "domain-core",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "packages/domain-core/src",
  "tags": ["scope:shared", "type:domain"],
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p packages/domain-core/tsconfig.lib.json --noEmit && tsc -p packages/domain-core/tsconfig.spec.json --noEmit"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --config packages/domain-core/vitest.config.ts"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p packages/domain-core/tsconfig.lib.json --noEmit"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint packages/domain-core/src --max-warnings=0"
      }
    }
  }
}
