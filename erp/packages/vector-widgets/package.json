{
  "name": "@redmountainsoap/vector-widgets",
  "version": "0.1.0",
  "description": "Framework-neutral Lit vector controls for Red Mountain Soap Calculator.",
  "license": "MIT",
  "type": "module",
  "sideEffects": true,
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    },
