      "import": "./src/vector-math.js"
    }
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "lit": "^3.3.3"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/redmountain-git/soap-suite.git",
    "directory": "erp/packages/vector-widgets"
  }
